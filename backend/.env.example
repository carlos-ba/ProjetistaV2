APP_ENV=production
APP_NAME=Projetista V2 API

# Banco de dados
DATABASE_URL=postgresql+psycopg://user:password@host:5432/projetista_v2

# CORS — coloque a URL exata do seu frontend
CORS_ORIGINS=["https://seu-frontend.vercel.app"]

# JWT — gere com: openssl rand -hex 32
SECRET_KEY=cole-aqui-a-chave-gerada

# Email (ex: Gmail com App Password)
MAIL_USERNAME=seu@email.com
MAIL_PASSWORD=sua-app-password
MAIL_FROM=seu@email.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# URL do frontend para links nos emails
FRONTEND_URL=https://seu-frontend.vercel.app

# Webhook do Checkout TheMembers/TheBank — deixar ENABLED=false até confirmar
# payload real de cada produto (ver docs/handoffs/especificacao-webhook-checkout-themembers-2026-09-03.md)
THEMEMBERS_WEBHOOK_ENABLED=False
THEMEMBERS_WEBHOOK_TOKEN=cole-aqui-o-token-do-painel-themembers
THEMEMBERS_PRODUCT_MONTHLY_ID=
THEMEMBERS_PRODUCT_SEMIANNUAL_ID=
THEMEMBERS_PRODUCT_PREMIUM_ID=
